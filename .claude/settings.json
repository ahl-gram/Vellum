{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "F=\"${CLAUDE_PROJECT_DIR}/.claude/skills/vellum-footguns/hooks/footgun-gate.py\"; if [ -f \"$F\" ]; then exec /usr/bin/python3 \"$F\"; fi; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
