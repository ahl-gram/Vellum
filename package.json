{
  "name": "vellum",
  "version": "0.1.0",
  "description": "An atelier of imaginary cartography — procedurally surveys worlds that don't exist and drafts them as antique atlas charts.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "chart": "node src/cli/main.ts chart",
    "dev": "npm run astro:dev",
    "og": "node scripts/build/build-og.ts",
    "icons": "node scripts/build/build-icons.ts",
    "plate-face": "node scripts/build/plate-face.ts",
    "outlines": "node scripts/build/outlines/main.ts",
    "charts:regen": "node scripts/build/regen-hero-charts.ts",
    "delivery": "node scripts/agent-infra/delivery/main.ts",
    "handoff": "node scripts/agent-infra/handoff/main.ts",
    "issue": "node scripts/agent-infra/issue-reader/main.ts",
    "proof": "node scripts/ci/proof-runner/main.ts",
    "comment-judge": "node scripts/review/comment-judge/main.ts",
    "comment-sweep": "node scripts/review/comment-sweep/main.ts",
    "copy-hunt": "node scripts/review/copy-hunt/main.ts",
    "recon-triage": "node scripts/agent-infra/recon-triage/main.ts",
    "keeper-scan": "node scripts/review/keeper-scan/main.ts",
    "still-judge": "node scripts/review/still-judge/main.ts",
    "agents:generate": "node scripts/agent-infra/main.ts generate",
    "agents:check": "node scripts/agent-infra/main.ts check",
    "astro:generate": "node scripts/build/clean-generated.ts && node scripts/build/kit-fonts.ts && node scripts/build/place-files.ts && node scripts/build/build-app-bundles.ts && node scripts/build/generate-showcases.ts && node scripts/build/generate-discovery.ts && node scripts/build/primer-steps.ts && node scripts/build/primer-pictures/main.ts",
    "astro:dev": "npm run astro:generate && astro dev",
    "astro:preview": "astro preview",
    "build": "npm run astro:generate && astro build",
    "test": "node scripts/ci/unit-suite.ts",
    "test:e2e": "node e2e/run.ts",
    "test:e2e:lanes": "node e2e/lanes.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.engine.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.1",
    "@eslint/css": "^2.0.0",
    "@eslint/css-tree": "^4.0.5",
    "@eslint/js": "^10.0.1",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/estree": "^1.0.6",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.0.0",
    "astro": "^7.4.7",
    "eslint": "^10.11.0",
    "fontkit": "^2.0.4",
    "linkedom": "0.18.15",
    "prettier": "3.9.9",
    "smol-toml": "1.9.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
