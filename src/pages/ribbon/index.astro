---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoomFolio from "../../layouts/RoomFolio.astro";
import Fog from "../../layouts/Fog.astro";
import Vignettes from "../../layouts/Vignettes.astro";
import ChartStage from "../../layouts/ChartStage.astro";
import Glass from "../../layouts/Glass.astro";
import ChartFolio from "../../layouts/ChartFolio.astro";
import LegendButton from "../../layouts/LegendButton.astro";
import Slip from "../../layouts/Slip.astro";

const room = "The Wayfarer's Ribbon";
const tagline = "the road, unrolled";
---

<BaseLayout
  room={room}
  description="Any road journey unrolled as an itinerary strip chart: the way drawn league by league up the scroll, with a compass turning to keep true north."
  path="/ribbon/"
  chartRoom
>
<Fog />
<ChartStage label="The scroll. Arrow keys pan, plus and minus keys zoom, 0 shows the full sheet.">
  <img id="rb-plate" class="plate" alt="" hidden>
  <Fragment slot="after">
    <p class="status" id="rb-status" role="status" aria-live="polite"></p>
    <p id="rb-warning" class="warning" hidden>Your browser could not start the render worker,
    so the scroll is drawn on the main thread. It may pause the page for a moment.</p>
    <noscript>
      <p class="status">Every scroll is unrolled in your browser, so the Ribbon needs
      JavaScript. You can still browse the <a href="../gallery/">gallery</a>.</p>
    </noscript>
  </Fragment>
</ChartStage>
<Vignettes />

<RoomFolio room={room} tagline={tagline}>
  <div class="folio-controls" role="group" aria-label="The journey">
    <div class="journey" id="rb-journey">
      <label class="jl" for="rb-from">setting out from</label>
      <select id="rb-from" class="control" aria-label="setting out from"></select>
      <label class="jl" for="rb-to">bound for</label>
      <select id="rb-to" class="control" aria-label="bound for"></select>
    </div>
    <button id="rb-swap" class="primary" type="button">Turn about</button>
  </div>
  <p class="gloss">choose where you set out and where you are bound; the surveyor unrolls the way between</p>
</RoomFolio>

<Slip id="itinerary" verb="The itinerary" title="The Itinerary" where="league by league, as the wayfarers' chain measured it" fold="Fold the itinerary away">
  <div class="journey-dock"></div>
  <p class="intro">Every bridge and ford, every wayside village, every fork signed for the town it leaves for, as the wayfarers' chain measured them.</p>
  <p class="itinerary-head"><span>The way, league by league</span></p>
  <ol class="contents itinerary" id="rb-itinerary"></ol>
  <p class="row-gloss">A row leans the Glass on that stretch of the road.</p>
  <div class="legend-dock"></div>
</Slip>

<ChartFolio lines={[["folio-title", "folio-title"], ["folio-sub", "folio-sub"], ["folio-coords", "rb-unrolled"]]} />

<nav class="legend" aria-label="The roads out">
  <p class="legend-head">The roads out</p>
  <div class="legend-row">
    <LegendButton id="rb-chart-link" gold href="/explorer/" verb="Return to" room="The Explorer" />
    <LegendButton id="rb-prospect-link" href="/prospect/" verbId="rb-prospect-verb" verb="See the road's end in" room="The Prospect" />
  </div>
</nav>

<Glass />

<script type="module" src="./app.bundle.js" is:inline></script>
</BaseLayout>
