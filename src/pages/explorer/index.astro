---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoomFolio from "../../layouts/RoomFolio.astro";
import Fog from "../../layouts/Fog.astro";
import Vignettes from "../../layouts/Vignettes.astro";
import Glass from "../../layouts/Glass.astro";
import ChartFolio from "../../layouts/ChartFolio.astro";
import LegendButton from "../../layouts/LegendButton.astro";
import Slip from "../../layouts/Slip.astro";

const room = "The Explorer";
const tagline = "every seed is a world, draw one";
---

<BaseLayout
  room={room}
  description="Generate procedural fantasy maps in your browser. Every seed is a world."
  path="/explorer/"
  extraCss={["/living-chart.css", "/explorer/broadside.css", "/explorer/chart-drawer.css"]}
  chartRoom
>
<Fog />
<div class="stage">
  <!-- The sheet is the Glass's gesture box, so a bookmark's cx/cy are SHEET fractions. Never restructure INSIDE #map: draw() wipes it with innerHTML and re-appends the overlay. -->
  <div class="sheet" id="sheet"><div class="sheet-inner" id="sheet-inner">
  <div id="map-viewport" tabindex="0" role="application" aria-label="Interactive map. Arrow keys pan, plus and minus keys zoom, 0 resets."><div id="map" class="living-chart"></div></div>
  <div id="verso" aria-hidden="true"></div>
  </div></div>
  <p class="status" id="status" role="status" aria-live="polite"></p>
  <noscript>
    <p class="status">Every world is drawn in your browser, so the Explorer needs
    JavaScript. You can still browse the <a href="../gallery/">gallery</a>.</p>
  </noscript>
</div>
<Vignettes />

<RoomFolio room={room} tagline={tagline}>
  <div class="folio-controls" role="group" aria-label="The seed">
    <input id="seed" class="control" type="number" min="0" max="4294967295" step="1" aria-label="seed">
    <button id="random" class="dice" type="button" title="random seed" aria-label="Random seed">&#9860;</button>
    <button id="draw" class="primary">Draw</button>
  </div>
  <p class="gloss">every chart is reproducible from the number in its margin</p>
</RoomFolio>

<!-- The Broadside (#270 rulings): the controls grouped by what they do to the WORLD, The Land reshaping the geography and The Hand dressing the same world. Every input keeps its id, events, and redraw semantics exactly as app.ts/controls.ts wire them. -->
<Slip id="broadside" verb="Make one" title="The Broadside" where="the land, and the hand that dresses it" fold="Fold the broadside away">
  <Fragment slot="tabs">
    <button id="leaf-broadside" type="button" aria-selected="true">The Broadside</button>
    <button id="leaf-table" type="button" aria-selected="false">The Table</button>
  </Fragment>
  <div class="broadside">
    <div class="panel" role="group" aria-labelledby="grp-land">
      <p class="panel-head archivist-head" id="grp-land">The Land</p>
      <p class="panel-gloss">these shape the world itself</p>
      <div class="ledger">
        <span class="l-label"><label for="type">type</label><a class="fn" href="/glossary/#seeds-choice" data-note="note-seeds-choice" aria-describedby="note-seeds-choice" aria-label="note on the seed's choice">&dagger;</a></span>
        <span class="l-ctl"><select id="type">
          <option value="" selected>seed's choice</option>
          <option value="island">island</option>
          <option value="archipelago">archipelago</option>
          <option value="continent">continent</option>
          <option value="citystate">city-state</option>
        </select></span>
        <span class="l-label"><label for="band">climate</label></span>
        <span class="l-ctl"><select id="band">
          <option value="" selected>seed's choice</option>
          <option value="temperate">temperate</option>
          <option value="tropical">tropical</option>
          <option value="polar">polar</option>
        </select></span>
        <span class="l-label"><label for="land">sea level</label></span>
        <span class="land-end land-end-min">more sea</span>
        <input id="land" type="range" min="100" max="700" step="2">
        <span class="land-end land-end-max">more land</span>
        <span id="land-readout" class="land-readout"></span>
        <span class="l-label"><label for="coast">coast</label><a class="fn" href="/glossary/#coast-warp" data-note="note-coast-warp" aria-describedby="note-coast-warp" aria-label="note on the coast warp">&Dagger;</a></span>
        <span class="land-end land-end-min">calm</span>
        <input id="coast" type="range" min="0" max="100" step="5">
        <span class="land-end land-end-max">lobed</span>
        <span id="coast-readout" class="land-readout"></span>
      </div>
    </div>
    <div class="panel" role="group" aria-labelledby="grp-hand">
      <p class="panel-head archivist-head" id="grp-hand">The Hand</p>
      <p class="panel-gloss">these dress the same world</p>
      <div class="ledger">
        <span class="l-label"><label for="style">style</label></span>
        <span class="l-ctl"><select id="style">
          <option value="antique" selected>antique</option>
          <option value="topographic">topographic</option>
          <option value="ink">ink</option>
          <option value="nautical">nautical</option>
        </select></span>
        <span class="l-label"><label for="theme">theme</label></span>
        <span class="l-ctl"><select id="theme">
          <option value="" selected>none</option>
          <option value="vegetation">vegetation</option>
          <option value="climate">temperature</option>
          <option value="moisture">rainfall</option>
          <option value="population">population</option>
        </select></span>
        <span class="l-label"></span>
        <span class="l-ctl seals">
          <label class="check seal">legend <input id="legend" type="checkbox" checked></label>
          <label class="check seal">arms <input id="arms" type="checkbox"></label>
          <label class="check seal">beasts <input id="beasts" type="checkbox"></label>
          <!-- The survey ink (#317 decision 1): ticked inks the completed survey track onto the sheet at rest; time itself lives in the Reading Room. The id stays `ages`; the box is 1:1 with the bare `survey` hash flag. -->
          <label class="check seal">survey <input id="ages" type="checkbox"></label><a class="fn" href="/glossary/#survey" data-note="note-survey" aria-describedby="note-survey" aria-label="note on the survey">*</a>
        </span>
      </div>
    </div>
    <div class="fn-note" id="note-seeds-choice" role="tooltip" popover="auto">
      <strong class="fn-head">of the seed's choice</strong>
      <span>Left alone, each world decides its own shape and weather from its seed. Pick a value to overrule it.</span>
      <a href="/glossary/#seeds-choice">read more in the glossary</a>
    </div>
    <div class="fn-note" id="note-coast-warp" role="tooltip" popover="auto">
      <strong class="fn-head">of the coast warp</strong>
      <span>How much the coastline wanders: calm keeps the shore plain, lobed lets bays and headlands cut deeper. Each step of warp is a different world, redrawn when you let go.</span>
      <a href="/glossary/#coast-warp">read more in the glossary</a>
    </div>
    <div class="fn-note" id="note-survey" role="tooltip" popover="auto">
      <strong class="fn-head">of the survey</strong>
      <span>Inks the expedition's completed track onto the sheet, with the ship's daily stations. Its day-by-day journal is kept in the Reading Room.</span>
      <a href="/glossary/#survey">read more in the glossary</a>
    </div>
    <div class="fn-note" id="note-verso" role="tooltip" popover="auto">
      <strong class="fn-head">of the verso</strong>
      <span>Every chart has two faces: the recto carries the map, the verso its docket, the surveyor's attribution, and the office stamp. Turn the sheet to read the back.</span>
      <a href="/glossary/#verso">read more in the glossary</a>
    </div>
  </div>
  <!-- The phone's Chart Table (#518 ruling 4): the gathered sheets are DOCKED here from the drawer at narrow, so one set of elements has two homes and neither is a copy. -->
  <div class="table-leaf" id="table-leaf"></div>
  <div class="legend-dock" id="legend-dock"></div>
</Slip>

<ChartFolio lines={[["folio-title", "folio-title"], ["folio-sub", "folio-sub"], ["folio-coords", "caption"]]} />

<!-- Both roads' hrefs are kept current beside every hash write (app.ts). -->
<nav class="legend" aria-label="The Press">
  <p class="legend-head" id="grp-press">The Press &middot; what the sheet can do next</p>
  <div class="legend-row" role="group" aria-labelledby="grp-press">
    <button id="verso-turn" class="legend-btn" type="button"><span class="verb">Turn</span><span class="room">The Sheet</span></button><a class="fn" href="/glossary/#verso" data-note="note-verso" aria-describedby="note-verso" aria-label="note on the verso">&sect;</a>
    <LegendButton id="order-plates" gold href="../print-room/" verb="Take to" room="The Print Room" />
    <LegendButton id="journal-link" gold href="/reading-room/" verb="Read the journal in" room="The Reading Room" />
  </div>
</nav>

<!-- The Chart Table drawer (direction D at the #518 sitting): authored here, bound by chart-drawer.ts; the cuttings are rendered from the address, which is the table's only memory (no browser storage). -->
<button id="chart-drawer-tab" class="chart-drawer-tab" type="button" aria-expanded="false" aria-controls="chart-drawer">The Drawer &middot; the table is bare</button>
<div id="chart-drawer" class="chart-drawer" role="region" aria-label="The Chart Table">
  <div class="chart-drawer-head">
    <p class="card-verb">Gathered from the Glass</p>
    <h2 class="card-title">The Chart Table</h2>
    <p class="count" id="chart-drawer-count">the table is bare</p>
    <button id="chart-drawer-shut" class="legend-btn shut" type="button"><span class="verb">Shut</span><span class="room">The Drawer</span></button>
  </div>
  <ol class="cuttings" id="cuttings"></ol>
  <div class="chart-drawer-road" id="table-road-band">
    <p class="full" id="chart-drawer-full" hidden>no room for more</p>
    <span class="stamp" id="table-road-stamp">the portfolio is not yet bound</span>
    <button id="table-road" class="legend-btn gold" type="button" disabled><span class="verb">Take the table to</span><span class="room">The Print Room</span></button>
  </div>
</div>

<Glass id="zoom-controls" />

<script type="module" src="./app.bundle.js" is:inline></script>
</BaseLayout>
