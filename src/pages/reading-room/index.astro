---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  room="The Reading Room"
  description="The atelier's reading room: sit with any seed's world and watch its founding voyage flow into its recorded ages on one continuous timeline."
  path="/reading-room/"
  tagline="watch a world live"
  extraCss={["/living-chart.css", "/reading-frame.css"]}
>

<p class="intro">This is the atelier's reading room, where a chart is watched rather
than worked. The room opens on a world at rest, its whole story already told in the
journal beneath. Press Play to hear it from the beginning: the survey sails first,
and the years follow.</p>

<p id="rr-warning" class="warning" hidden>Your browser could not start the render
worker, so the chart is drawn on the main thread. The page may pause for a moment.</p>

<!-- The reading frame (#219) mounts here and builds its own DOM: the chart, the one
     polite status line, and the fused instrument (#220) over the one dated log. -->
<div id="rr-mount"></div>

<script type="module" src="./app.bundle.js" is:inline></script>
</BaseLayout>
