---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoomFolio from "../../layouts/RoomFolio.astro";
import Fog from "../../layouts/Fog.astro";
import Vignettes from "../../layouts/Vignettes.astro";
import ChartStage from "../../layouts/ChartStage.astro";
import Glass from "../../layouts/Glass.astro";
import ChartFolio from "../../layouts/ChartFolio.astro";
import LegendButton from "../../layouts/LegendButton.astro";
import Slip from "../../layouts/Slip.astro";
import { contentsRows } from "../../site/print-room/contents-markup.ts";

const room = "The Print Room";
const tagline = "take a world home";
const contents = contentsRows(null);
---

<BaseLayout
  room={room}
  description="The atelier's print room: bring a world in from the Explorer or call up a seed by number, pull a proof, and take the chart home."
  path="/print-room/"
  chartRoom
>
<Fog />
<ChartStage label="The proof. Arrow keys pan, plus and minus keys zoom, 0 shows the full sheet.">
  <div id="pr-preview" class="preview"></div>
  <img id="pr-turned" class="turned" alt="" hidden>
  <div id="pr-page" class="page" hidden>
    <div id="pr-page-inner" class="page-inner matter-page"></div>
  </div>
  <Fragment slot="after">
    <p class="status" id="pr-status" role="status" aria-live="polite"></p>
    <p id="pr-warning" class="warning" hidden>Your browser could not start the render
    worker, so proofs are drawn on the main thread. A large plate may pause the page for
    a moment.</p>
    <noscript>
      <p class="status">Every proof is pulled in your browser, so the Print Room needs
      JavaScript. You can still browse the <a href="../gallery/">gallery</a>.</p>
    </noscript>
  </Fragment>
</ChartStage>
<Vignettes />

<RoomFolio room={room} tagline={tagline}>
  <div class="folio-controls" role="group" aria-label="Choose a world">
    <input id="pr-seed" class="control" type="number" min="0" max="4294967295" step="1" aria-label="seed">
    <button id="pr-random" class="dice" type="button" title="random seed" aria-label="Random seed">&#9860;</button>
    <select id="pr-style" class="control" aria-label="style">
      <option value="antique" selected>antique</option>
      <option value="topographic">topographic</option>
      <option value="ink">ink</option>
      <option value="nautical">nautical</option>
    </select>
    <button id="pr-draw" class="primary" type="button">Pull a proof</button>
  </div>
  <p class="gloss">bring a chart in from the Explorer, or call one up by number</p>
</RoomFolio>

<Slip id="atlas" verb="Take home" title="The Bound Atlas" where="the whole atlas on one sheet" fold="Fold the atlas away">
  <p class="intro">Every draughting, the thematic and regional surveys, the banners, the
  chronicle, and the gazetteer, bound from the proof on the desk.</p>
  <p class="bound-line" id="pr-bound-status" role="status" aria-live="polite"></p>
  <div class="bind-row">
    <button id="pr-bind" class="primary" type="button" disabled>Bind the atlas</button>
    <span class="stamp" id="pr-stamp">a few seconds to draw</span>
  </div>
  <p class="contents-head"><span>Contents of the atlas</span><span class="gloss turn-gloss">a thumbnail turns the sheet</span></p>
  <ol class="contents" id="pr-contents" set:html={contents}></ol>
  <div class="legend-dock"></div>
  <Fragment slot="foot">
    <div class="atlas-actions" role="group" aria-label="Bound atlas">
      <button id="pr-print" class="primary" type="button" disabled>Print</button>
      <button id="pr-download" type="button" disabled>Download</button>
      <button id="pr-hide" type="button" disabled>Hide</button>
    </div>
    <p class="note">Print opens your browser's Save as PDF, one plate per page. The single
    file opens offline in any browser.</p>
  </Fragment>
</Slip>

<ChartFolio lines={[["folio-title", "folio-title"], ["folio-sub plate-line", "pr-plate-line"], ["folio-sub", "folio-sub"]]} />

<nav class="legend" aria-label="A poster plate">
  <p class="legend-head"><span class="pressed">A poster plate, pressed as
    <select id="pr-format" aria-label="Pressed as">
      <option value="svg" selected>The engraving itself (SVG)</option>
      <option value="png1">An impression (PNG)</option>
      <option value="png2">A finer impression (PNG &times;2)</option>
    </select></span></p>
  <p class="legend-note">The engraving is exact at any size; an impression is pressed with your
  device's fonts, and a large one is fitted to what your browser can hold.
  The chart is pulled only as the engraving.</p>
  <div class="legend-row" role="group" aria-label="A poster plate">
    <button class="legend-btn" type="button" data-poster="chart" disabled><span class="verb dim">1500 px</span><span class="room">Chart</span></button>
    <button class="legend-btn" type="button" data-poster="desk" disabled><span class="verb dim">2400 px</span><span class="room">Desk</span></button>
    <button class="legend-btn" type="button" data-poster="wall" disabled><span class="verb dim">3300 px</span><span class="room">Wall</span></button>
    <button class="legend-btn" type="button" data-poster="grand" disabled><span class="verb dim">4200 px</span><span class="room">Grand</span></button>
    <LegendButton id="pr-explorer" gold href="../explorer/" verb="Back to" room="The Explorer" />
  </div>
  <p class="legend-status" id="pr-poster-status" role="status" aria-live="polite"></p>
</nav>

<Glass />

<div id="pr-atlas" class="atlas-sheet"></div>
<div id="pr-page-measure" class="page-measure matter-page" aria-hidden="true"></div>

<script type="module" src="./app.bundle.js" is:inline></script>
</BaseLayout>
