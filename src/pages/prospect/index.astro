---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PLATE_W, PLATE_H } from "../../prospect/geometry.ts";
---

<BaseLayout
  room="The Prospect"
  description="Any settlement's engraved townscape plate: the second camera beside the chart, drawn side-on from the place's own ground."
  path="/prospect/"
  tagline="the second camera"
>

<p class="intro">The chart is one camera: the world seen from directly above. A prospect
is the other one the old ateliers sold beside it, a settlement drawn side-on from its own
ground. Open one from any settlement's card in the Explorer; the same place, chart, and
year always press the same plate.</p>

<p id="pp-warning" class="warning" hidden>Your browser could not start the render worker,
so the plate is engraved on the main thread. It may pause the page for a moment.</p>

<p class="status" id="pp-status" role="status" aria-live="polite"></p>

<figure class="plate-figure">
  <img id="pp-plate" width={PLATE_W} height={PLATE_H} alt="" hidden>
  <figcaption class="caption" id="pp-caption"></figcaption>
</figure>

<div class="actions"><a id="pp-chart-link" class="control" href="/explorer/">Return to the Explorer</a></div>

<script type="module" src="./app.bundle.js" is:inline></script>
</BaseLayout>
