---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoomFolio from "../../layouts/RoomFolio.astro";
import Slip from "../../layouts/Slip.astro";

const room = "The Prospect";
const tagline = "the second camera";
---

<BaseLayout
  room={room}
  description="Any settlement's engraved townscape plate: the second camera beside the chart, drawn side-on from the place's own ground."
  path="/prospect/"
  chartRoom
>
<div class="fog a" aria-hidden="true"></div><div class="fog b" aria-hidden="true"></div>
<div class="stage">
  <div class="sheet" id="sheet"><div id="map-viewport" tabindex="0" role="application" aria-label="The plate. Arrow keys pan, plus and minus keys zoom, 0 shows the full sheet."><div id="map">
    <img id="pp-plate" class="plate" alt="" hidden>
  </div></div></div>
  <p class="status" id="pp-status" role="status" aria-live="polite"></p>
  <p id="pp-warning" class="warning" hidden>Your browser could not start the render worker,
  so the plate is engraved on the main thread. It may pause the page for a moment.</p>
  <noscript>
    <p class="status">Every plate is engraved in your browser, so the Prospect needs
    JavaScript. You can still browse the <a href="../gallery/">gallery</a>.</p>
  </noscript>
</div>
<div class="vignette top" aria-hidden="true"></div><div class="vignette bottom" aria-hidden="true"></div>

<RoomFolio room={room} tagline={tagline}>
  <form class="folio-controls" id="pp-year-form" aria-label="The year viewed">
    <label class="year-label" for="pp-year">viewed in the year</label>
    <input id="pp-year" class="control" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="year">
    <button id="pp-engrave" class="primary" type="submit">Engrave</button>
  </form>
  <p class="gloss">turn the year back, even to the ground before it rose</p>
</RoomFolio>

<Slip id="note" verb="The engraver's note" title="The Engraver's Note" where="drawn side-on from the town's own ground" fold="Fold the engraver's note away">
  <p class="note-prose" id="pp-note"></p>
  <p class="key-head" id="pp-key-head">The key to the plate</p>
  <ol class="contents plate-key" id="pp-key"></ol>
  <p class="era" id="pp-era"></p>
  <p class="era-gloss">The same place, chart and year always press the same plate. Open another settlement's prospect from its card in the Explorer.</p>
  <div class="legend-dock"></div>
</Slip>

<div class="chrome corner bl folio">
  <p class="folio-title" id="folio-title"></p>
  <p class="folio-sub" id="folio-sub"></p>
  <p class="folio-coords" id="pp-pressed"></p>
</div>

<nav class="legend" aria-label="The roads out">
  <p class="legend-head">The roads out</p>
  <div class="legend-row">
    <a id="pp-chart-link" class="legend-btn gold" href="/explorer/"><span class="verb">Return to</span><span class="room">The Explorer</span></a>
    <a id="pp-ribbon-link" class="legend-btn" href="/ribbon/"><span class="verb" id="pp-ribbon-verb">Take the road from here in</span><span class="room">The Wayfarer's Ribbon</span></a>
  </div>
</nav>

<div class="chrome corner br zoomery" role="group" aria-label="The Surveyor's Glass">
  <button id="zoom-in" class="zoom-btn" type="button" data-zoom="in" aria-label="Lean closer (zoom in)" title="Lean closer"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="6.8" cy="6.8" r="4.2"/><path d="M9.9 9.9l3.7 3.7"/><path d="M6.8 4.9v3.8M4.9 6.8h3.8"/></svg></button>
  <button id="zoom-reset" class="zoom-btn" type="button" data-zoom="fit" aria-label="The full sheet (reset the view)" title="The full sheet"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3.4 2.6h6.6l2.6 2.6v8.2H3.4z"/><path d="M10 2.6v2.6h2.6"/><path d="M5.3 9.7c1-.9 1.9.5 2.9-.3.8-.7 1.5-.2 2.2-.7"/></svg></button>
  <button id="zoom-out" class="zoom-btn" type="button" data-zoom="out" aria-label="Stand back (zoom out)" title="Stand back"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="6.8" cy="6.8" r="4.2"/><path d="M9.9 9.9l3.7 3.7"/><path d="M4.9 6.8h3.8"/></svg></button>
  <div class="zoom-keys" aria-hidden="true">
    <span><kbd>+</kbd> <kbd>&#8722;</kbd> lean closer, stand back</span>
    <span><kbd>&#8592;&#8593;&#8594;&#8595;</kbd> pan the sheet</span>
    <span><kbd>0</kbd> the full sheet</span>
  </div>
</div>

<script type="module" src="./app.bundle.js" is:inline></script>
</BaseLayout>
