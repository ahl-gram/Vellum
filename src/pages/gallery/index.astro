---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoomFolio from "../../layouts/RoomFolio.astro";
import Fog from "../../layouts/Fog.astro";
import LegendButton from "../../layouts/LegendButton.astro";
import LegendRow from "../../layouts/LegendRow.astro";
import { GALLERY_COUNT, GALLERY_SEED, cardFigureHtml, galleryCards } from "../../cli/gallery.ts";

// Composed at build time from the same composer generate-showcases renders the SVGs with, so the two runs agree on worlds and filenames.
const figures = galleryCards(GALLERY_SEED, GALLERY_COUNT).map(cardFigureHtml).join("\n");

const room = "The Gallery";
const tagline = "a dozen worlds, hung for viewing";
const dateline = `${GALLERY_COUNT} charts, from seed ${GALLERY_SEED}`;
---

<BaseLayout
  room={room}
  description="A contact sheet of twelve imaginary worlds, drawn by Vellum as antique charts and hung for viewing."
  path="/gallery/"
  chartRoom
>
<Fog />
<div class="grid" set:html={figures}></div>

<RoomFolio slot="desk" region room={room} tagline={tagline}>
  <p class="dateline">{dateline}</p>
</RoomFolio>

<LegendRow slot="desk" label="The road out">
  <Fragment slot="head">every plate is a road into its own world</Fragment>
  <LegendButton gold href="/explorer/" verb="Return to" room="The Explorer" />
</LegendRow>
</BaseLayout>
