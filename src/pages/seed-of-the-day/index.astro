---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoomFolio from "../../layouts/RoomFolio.astro";
import Fog from "../../layouts/Fog.astro";
import Vignettes from "../../layouts/Vignettes.astro";
import Glass from "../../layouts/Glass.astro";
import ChartFolio from "../../layouts/ChartFolio.astro";
import LegendButton from "../../layouts/LegendButton.astro";
import Slip from "../../layouts/Slip.astro";

const room = "The Seed of the Day";
const tagline = "today's date is the seed";
// The roads out (#462 chart-room ruling 4): the legend row on a wide sheet, docked inside the slip on a phone (room.ts); app.ts stamps today's seed onto them.
const roads = [
  { road: "explorer", verb: "Open today's seed in", room: "The Explorer", href: "../explorer/" },
  { road: "reading-room", verb: "Watch today's world in", room: "The Reading Room", href: "../reading-room/" },
];
---

<BaseLayout
  room={room}
  description="A new procedural world every day: today's date is the seed, drawn as an antique chart with a line from its gazetteer. Same day, same world, everywhere."
  ogDescription="A new procedural world every day: today's date is the seed, drawn as an antique chart with a line from its gazetteer."
  path="/seed-of-the-day/"
  chartRoom
>
<Fog />
<div class="stage">
  <!-- #167 The Surveyor's Glass, re-seated as the chart room (#462): #map-viewport is the whole stage and the gesture box the shared zoom-controller binds to; the live transform lands on #map, sized to the viewport with the chrome's reserves as padding, so d3's clamp keeps it covering the stage; #sheet inside is the chart's own box (fitted by src/site/shared/room.ts), and the hunt star and the miss soundings ride it. -->
  <div id="map-viewport" tabindex="0" role="application" aria-label="Today's chart. Arrow keys pan, plus and minus keys zoom, 0 shows the full sheet."><div id="map"><div id="sheet" class="sheet"></div></div></div>
  <p class="status" id="status">Drafting today's world&hellip;</p>
  <noscript>
    <p class="status">Today's world is drawn in your browser, so this page needs
    JavaScript. You can still <a href="../explorer/">draw any seed in the
    Explorer</a> or browse the <a href="../gallery/">gallery</a>.</p>
  </noscript>
</div>
<Vignettes />

<RoomFolio room={room} tagline={tagline}>
  <p class="dateline" id="dateline"></p>
</RoomFolio>

<Slip id="hunt" verb="Find one" title="The Daily Hunt" where="one forgotten place on today's chart" fold="Fold the hunt away">
  <p class="hunt-intro intro">One forgotten place hides on today's chart. Read the
  survey notes, then click the map to find it. Everyone hunting today's seed is
  looking for the same place.</p>
  <ol class="clues" id="clues"></ol>
  <p class="hunt-status" id="hunt-status" aria-live="polite"></p>
  <div class="reveal" id="reveal" hidden></div>
  <div class="hunt-actions">
    <button type="button" id="share" hidden>Share your find</button>
    <button type="button" id="dispatch" hidden>Draft dispatch</button>
    <span class="streak" id="streak"></span>
  </div>
  <div class="legend-dock"></div>
  <p class="note" slot="foot">The seed is today's date in UTC (YYYYMMDD), so everyone
  sees the same world on the same day. Your streak is kept on this device only: no
  account, no backend.</p>
</Slip>

<div id="hunt-sticky" class="hunt-sticky" aria-hidden="true" hidden></div>

<ChartFolio lines={[["folio-title", "folio-title"], ["folio-sub", "folio-sub"], ["folio-coords", "folio-coords"], ["folio-note", "folio-note"]]} />

<nav class="legend" aria-label="Today's roads out">
  <p class="legend-head">Same day, same world, everywhere &middot; come back tomorrow for a new one</p>
  <div class="legend-row">
    {roads.map((r) => <LegendButton road={r.road} href={r.href} verb={r.verb} room={r.room} />)}
  </div>
</nav>

<Glass />

<script type="module" src="app.bundle.js" is:inline></script>
</BaseLayout>
