---
// Sub 6 (#461, ruling 1): the room's h1 stands in the page, not the shell header; pages own its placement, this component keeps the markup one shape.
interface Props {
  room: string;
  tagline: string;
}
const { room, tagline } = Astro.props;
---
<div class="room-head">
  <h1 class="room-name">{room}</h1>
  <p class="room-tagline">{tagline}</p>
</div>
