---
// The stage's notices (Issue #827): the live status pill, the render-worker warning that stays hidden until the worker fails, and the scripts-off notice; the page passes the ids its script reads and writes its own sentences.
interface Props {
  pillId?: string;
  warningId?: string;
}
const { pillId, warningId } = Astro.props;
---
{pillId && <p class="status" id={pillId} role="status" aria-live="polite"><slot name="pill" /></p>}
{warningId && <p id={warningId} class="warning" hidden><slot name="warning" /></p>}
{Astro.slots.has("noscript") && <noscript>
  <p class="status"><slot name="noscript" /></p>
</noscript>}
