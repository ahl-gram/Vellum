---
// Sub 7 (#462, document-room rulings 1 to 4): the index slip, every section with its questions or its terms, read from the page's own source at build (room-sections.ts) so it cannot drift from the prose. Its script binds the fold, the phone sheet, the ink that follows the reader, and the Glossary's find box when the page carries one; one script for both rooms, inlined by Astro.
import Slip from "./Slip.astro";
import type { IndexSection } from "./room-sections.ts";

interface Props {
  sections: readonly IndexSection[];
  kind: "questions" | "terms";
}
const { sections, kind } = Astro.props;
---
<Slip id="index" verb="Find your way" title="On this page" where="the section you are reading is inked" fold="Fold the index away">
  <ol class="index">
    {sections.map((s) => (
      <li data-sec={s.id}>
        <a class="sec" href={`#${s.id}`}>{s.title}<span class="count">{s.entries.length}</span></a>
        {kind === "questions"
          ? <ol class="entries">{s.entries.map((e) => <li data-for={e.id}><a href={`#${e.id}`}>{e.text}</a></li>)}</ol>
          : <p class="terms">{s.entries.map((e) => <Fragment><a href={`#${e.id}`} data-for={e.id}>{e.text}</a>{" "}</Fragment>)}</p>}
      </li>
    ))}
  </ol>
</Slip>
<script>
  import { bindSlip } from "../site/shared/slip.ts";
  import { indexInk } from "../site/shared/index-ink.ts";
  import { findMarks, sectionEmpty } from "../site/glossary/term-find.ts";

  const slip = document.getElementById("index");
  const narrowQuery = window.matchMedia("(max-width: 900px)");
  const narrow = () => narrowQuery.matches;
  const folio = document.querySelector(".corner.tr");
  const rootPx = (prop: string) => parseFloat(getComputedStyle(document.documentElement).getPropertyValue(prop));

  // The slip hangs below the room's folio, the chart rooms' seat; a phone's sheet places itself.
  const place = () => {
    if (slip === null) return;
    if (narrow()) {
      slip.style.top = "";
      slip.style.maxHeight = "";
      return;
    }
    const top = (folio?.getBoundingClientRect().bottom ?? 0) + 16;
    slip.style.top = `${top}px`;
    slip.style.maxHeight = `${window.innerHeight - top - 22}px`;
  };

  if (slip !== null) {
    bindSlip({
      slip,
      fold: slip.querySelector(".slip-fold"),
      tab: document.querySelector(".slip-tab"),
      handle: slip.querySelector(".slip-handle"),
      onLayout: place,
      after: (run, ms) => { window.setTimeout(run, ms); },
    });
    const byData = (sel: string, key: string) =>
      new Map([...slip.querySelectorAll<HTMLElement>(sel)].map((el) => [el.dataset[key] ?? "", el]));
    const ink = indexInk({
      heads: [...document.querySelectorAll(".sheet h2[id]")],
      entries: [...document.querySelectorAll(".sheet :is(.q, .term)[id]")],
      rows: byData(".index > li[data-sec]", "sec"),
      entryRows: byData("[data-for]", "for"),
      // The reading line sits just under the band, where a followed anchor lands its head.
      line: () => rootPx("--band-h") * rootPx("font-size") + 24,
      keepInView: () => (narrow() ? null : slip.querySelector(".slip-body")),
    });
    window.addEventListener("scroll", ink, { passive: true });
    window.addEventListener("resize", () => { place(); ink(); });
    document.fonts?.ready.then(place);
    place();
    ink();
    for (const a of slip.querySelectorAll("a")) {
      a.addEventListener("click", () => {
        if (!narrow()) return;
        slip.classList.remove("open");
        slip.querySelector(".slip-handle")?.setAttribute("aria-expanded", "false");
      });
    }
    const find = document.querySelector<HTMLInputElement>(".find input");
    find?.addEventListener("input", () => {
      for (const li of slip.querySelectorAll<HTMLElement>(".index > li")) {
        const links = [...li.querySelectorAll<HTMLElement>(".terms a")];
        const marks = findMarks(links.map((a) => a.textContent ?? ""), find.value);
        links.forEach((a, i) => {
          a.classList.toggle("hit", marks[i].hit);
          a.classList.toggle("miss", marks[i].miss);
        });
        li.classList.toggle("empty", sectionEmpty(marks, find.value));
      }
    });
  }
</script>
