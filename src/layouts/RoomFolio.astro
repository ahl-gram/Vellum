---
// The room's h1 and tagline top right in the corner chrome (#462 chart-room ruling 2, document-room ruling 6), with the room's ONE control under them (the slot); the page owns what stands under the name, this component keeps the markup one shape.
interface Props {
  room: string;
  tagline: string;
}
const { room, tagline } = Astro.props;
---
<div class="chrome corner tr folio-room">
  <h1 class="room-name">{room}</h1>
  <p class="room-tagline">{tagline}</p>
  <slot />
</div>
