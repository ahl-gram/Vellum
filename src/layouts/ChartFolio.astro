---
// The chart's folio, lower left (the mockup; the Atelier Kit, #487): the lines a room writes at the draw, each a <p> the page's script fills by id; the page names them as [class, id] pairs.
interface Props {
  lines: ReadonlyArray<readonly [cls: string, id: string]>;
}
const { lines } = Astro.props;
---
<div class="chrome corner bl folio">
  {lines.map(([cls, id]) => <p class={cls} id={id}></p>)}
</div>
