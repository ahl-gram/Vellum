---
import { NAV_ITEMS, trailFor } from "./nav.ts";

// The one shared shell (the Sub 1 decision doc comment on #202; the atelier-map idiom at #461): head meta from the props, <title> computed from `room`, the fixed head cluster on the walnut deep, the canonical nav, the constant footer, and the rooms' landing ceremony.
interface Props {
  /** Names the room for the computed <title> ("The Print Room · Vellum"); absent on home ALONE, whose title stays the atelier's own line. The page renders the matching <RoomFolio>. */
  room?: string;
  /** The og twins' punctuation-normalized room, only when it differs from `room`: og:title AND twitter:title take `${ogRoom} · Vellum`. */
  ogRoom?: string;
  /** The name=description search snippet; also the og twins' default. */
  description: string;
  /** Fans out to og:description AND twitter:description, for a page whose card copy is shorter than its snippet; defaults to description. */
  ogDescription?: string;
  /** Root-absolute trailing-slash route ("/", "/faq/"): og:url + aria-current. */
  path: string;
  /** A room's <main> wears the interim desk panel unless its markup carries the full-bleed sheet, when "open" stands it bare on the deep. */
  desk?: "open";
  /** A CHART room (#462 chart-room rulings 7 and 9): the chart is the room, full bleed on the deep, so the page renders no band and no footer; main stands bare and hosts the stage and the room's fixed furniture. */
  chartRoom?: true;
  /** Extra root-absolute hrefs for SHARED sheets a page opts into; linked after the global sheets and before the page's own relative index.css, so page rules keep the last word. */
  extraCss?: readonly string[];
  /** A robots noindex meta. */
  noindex?: true;
}

const { room, ogRoom, description, ogDescription, path, desk: deskProp, chartRoom, extraCss = [], noindex } = Astro.props;

for (const href of extraCss) {
  if (!href.startsWith("/")) {
    throw new Error(`BaseLayout extraCss hrefs must be root-absolute ("/living-chart.css"), got "${href}"`);
  }
}

if (!/^\/([a-z0-9-]+\/)*$/.test(path)) {
  throw new Error(`BaseLayout path must be root-absolute directory form ("/faq/"), got "${path}"`);
}
const isHome = path === "/";
if (isHome === (room !== undefined)) {
  throw new Error(
    isHome
      ? 'home is the atelier, not a room: pass no room for path "/"'
      : `every room page must name its room (got none for "${path}")`,
  );
}
if (deskProp !== undefined && room === undefined) {
  throw new Error('desk="open" is a room-page choice; home has no desk panel to open');
}
if (chartRoom && room === undefined) {
  throw new Error("a chart room is a room: name it");
}
if (chartRoom && deskProp !== undefined) {
  throw new Error('a chart room has no desk to open: pass chartRoom or desk="open", not both');
}
const desk = chartRoom ? "open" : deskProp;

const HOME_TITLE = "Vellum · an atelier of imaginary cartography";
const SITE_TAGLINE = "an atelier of imaginary cartography";
const title = room ? `${room} · Vellum` : HOME_TITLE;
const ogTitle = ogRoom ? `${ogRoom} · Vellum` : title;
const ogUrl = new URL(path, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const ogImageAlt = "The Vellum wordmark and a compass rose on a dark walnut ground, with the chart of seed 42 faint behind.";
const cardDescription = ogDescription ?? description;
const trail = trailFor(path);
const Desk = room ? "div" : Fragment;
const deskAttrs = room ? { class: Astro.slots.has("desk") ? "desk-layer on" : "desk-layer" } : {};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=1024">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Vellum">
<meta property="og:url" content={ogUrl}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={cardDescription}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={cardDescription}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogImageAlt}>
<link rel="stylesheet" href="/fonts.css">
<link rel="stylesheet" href="/motion.css">
<link rel="stylesheet" href="/house.css">
<link rel="stylesheet" href="/atelier.css">
{extraCss.map((href) => <link rel="stylesheet" href={href} />)}
<link rel="stylesheet" href="index.css">
{["/", ...NAV_ITEMS.map((item) => item.href)]
  .filter((href) => href !== Astro.url.pathname)
  .map((href) => <link rel="prefetch" href={href} />)}
<link rel="stylesheet" href="/shell.css">
</head>
<body class={room ? (chartRoom ? "room chart-room" : "room") : undefined}>
<Desk {...deskAttrs}>
{room && !chartRoom && <div class="band" aria-hidden="true"></div>}
<header class="chrome">
  {room
    ? <p class="wordmark"><a href="/">Vellum</a></p>
    : <h1 class="wordmark"><a href="/">Vellum</a></h1>}
  <p class="tagline">{SITE_TAGLINE}</p>
  <nav class="rooms" aria-label="The rooms">
    {NAV_ITEMS.map((item, i) => (
      <Fragment>{i > 0 ? <span class="sep" aria-hidden="true">·</span> : ""}{item.href === path ? (
        <span aria-current="page">{item.label}</span>
      ) : (
        <a href={item.href}>{item.label}</a>
      )}</Fragment>
    ))}
  </nav>
  {trail && <div class="where"><nav class="trail" aria-label="Where you are">{trail.crumbs.map((c, i) => <Fragment>{i > 0 ? <Fragment><span class="way" aria-hidden="true">›</span><wbr /></Fragment> : ""}{i < trail.crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : trail.current ? <span aria-current="page">{c.name}</span> : <span class="here">{c.name}</span>}</Fragment>)}</nav>{trail.also.length > 0 && <p class="also">also reached from {trail.also.map((c, i) => <Fragment>{i > 0 ? " and " : ""}<a href={c.href}>{c.name}</a></Fragment>)}</p>}</div>}
  <slot name="header-extra" />
</header>
<slot name="desk" />
</Desk>
<main class:list={[room && desk !== "open" && "desk-panel"]}>

<slot />

</main>
{!chartRoom && <footer>
  Vellum · an atelier of imaginary cartography
</footer>}
<aside class="desk-notice" aria-label="A note on screen size">
  <p class="dn-head">Notice to Travellers</p>
  <p class="dn-body">These charts are drawn for a wider table. On a phone the page is set small: pinch to read closer, or come back at a desktop, a laptop or a large tablet.</p>
  <button type="button" class="dn-go">Continue anyway</button>
</aside>
{/* Astro-processed, not is:inline, so it can import the binders. */}
<script>
import "../site/shell/app.ts";
</script>
</body>
</html>
