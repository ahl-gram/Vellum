---
import { NAV_ITEMS } from "./nav.ts";

// The one shared shell (#203, ratified in the Sub 1 decision doc comment on #202): head
// meta with the prop fan-out, the canonical nav, the constant footer. The Running Head
// (#268) computes <title> from `room`, so title drift across pages is structurally impossible.
interface Props {
  /** The running head's right side and the computed <title> ("The Print Room · Vellum"); absent on home ALONE, whose title stays the atelier's own line. */
  room?: string;
  /** The og twins' punctuation-normalized room, only when it differs from `room`: og:title AND twitter:title take `${ogRoom} · Vellum`. */
  ogRoom?: string;
  /** The name=description search snippet; also the og twins' default. */
  description: string;
  /** Fans out to og:description AND twitter:description, for a page whose card copy is shorter than its snippet; defaults to description. */
  ogDescription?: string;
  /** Root-absolute trailing-slash route ("/", "/faq/"): og:url + aria-current. */
  path: string;
  /** The flourish line under the room name (under the wordmark alone on home). */
  tagline: string;
  /** Extra root-absolute hrefs for SHARED sheets a page opts into; linked after the global sheets and before the page's own relative index.css, so page rules keep the last word. */
  extraCss?: readonly string[];
}

const { room, ogRoom, description, ogDescription, path, tagline, extraCss = [] } = Astro.props;

for (const href of extraCss) {
  if (!href.startsWith("/")) {
    throw new Error(`BaseLayout extraCss hrefs must be root-absolute ("/living-chart.css"), got "${href}"`);
  }
}

if (!/^\/([a-z0-9-]+\/)*$/.test(path)) {
  throw new Error(`BaseLayout path must be root-absolute directory form ("/faq/"), got "${path}"`);
}
const isHome = path === "/";
if (isHome === (room !== undefined)) {
  throw new Error(
    isHome
      ? 'home is the atelier, not a room: pass no room for path "/"'
      : `every room page must name its room (got none for "${path}")`,
  );
}

const HOME_TITLE = "Vellum · an atelier of imaginary cartography";
const title = room ? `${room} · Vellum` : HOME_TITLE;
const ogTitle = ogRoom ? `${ogRoom} · Vellum` : title;
const ogUrl = new URL(path, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const ogImageAlt = "A Vellum antique chart beside the Vellum wordmark.";
const cardDescription = ogDescription ?? description;
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Vellum">
<meta property="og:url" content={ogUrl}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={cardDescription}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={cardDescription}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogImageAlt}>
<link rel="stylesheet" href="/fonts.css">
<link rel="stylesheet" href="/motion.css">
<link rel="stylesheet" href="/house.css">
{extraCss.map((href) => <link rel="stylesheet" href={href} />)}
<link rel="stylesheet" href="index.css">
{/* #329: prefetch the sibling shells so a first click commits instantly even while this
    page's plates are still streaming; derived from NAV_ITEMS plus home so the list can
    never rot; self is skipped. */}
{["/", ...NAV_ITEMS.map((item) => item.href)]
  .filter((href) => href !== Astro.url.pathname)
  .map((href) => <link rel="prefetch" href={href} />)}
<style is:global>
/* The shell dresses once (#263), part B: the recurring parchment/ink palette, consumed
   as var() by the page css files (guarded by test/site/shell-css.test.ts). The charts'
   own label ink stays the renderer's (byte-identity domain), deliberately not this hex. */
:root {
  --ink-dark: #4a3826;         /* dark walnut ink: borders, buttons, prose, emphasis */
  --ink-brown: #6b5a40;        /* flourish brown: taglines, captions, asides */
  --ink-faded: #857257;        /* faded ink: nav, footer, small labels */
  --line-tan: #b9a77f;         /* pale tan hairline: rules and frame borders */
  --parchment: #efe6cf;        /* the page ground every sheet rests on */
  --parchment-panel: #f4ecd8;  /* raised panels, cards, and pinned slips */
  --parchment-bright: #fff7e4; /* the lit cream: hovers and the reveal */
  --parchment-deep: #e6d9b8;   /* the pressed tan: code chips */
  --line-faint: #cdbd97;       /* the softer hairline, a shade lighter than --line-tan */
  /* #367: the ONE depth a chart rests at, everywhere (was seven longhand 0.2 copies; the
     armed Explorer's doubled shadow measured 0.385 and 0.4 was ratified as the house
     depth). Anything laid OVER a chart inside the mount opts out: see public/living-chart.css. */
  --sheet-shadow: 0 12px 34px rgb(from var(--chart-ink) r g b / 0.4);
  /* The Specimen Book (#324, ratified 2026-07-30); the roster mirrors src/atlas/palette.ts exactly (the shell-css deepEqual). */
  --ink-annals: #3f3122;       /* the chronicler's iron-gall (journal entries, #312) */
  --ink-surveyor: #7a5f38;     /* the surveyor's walnut italic (journal prologue, #312) */
  --ink-surveyor-faded: #99855f; /* the surveyor's unbolded gutter days (#312) */
  --control-cream: #f8f1e0;    /* the control idiom's cream fill */
  --ink-press: #5d4831;        /* the dark primary pressed (hover) */
  --control-gold: #f0e3bd;     /* the featured action-link's parchment gold (#133/#199) */
  --control-gold-lit: #f7edcd; /* the gold, lit on hover */
  --ink-tale: #54452f;         /* the tale/note ink: place-card tales, atlas notes */
  --iron-red: #7a1f12;         /* the site's ink red (hunt star, statuses); was motion.css's */
  /* The --chart-* quotations borrow render/style.ts values (house-style.test.ts pins each
     to the constant it quotes). --chart-ink is the retired lettering ink's ONE sanctioned
     site-side home (shell-css pins this declaration); shadows consume it via rgb(from ...). */
  --chart-paper: #f2e8cf;      /* the antique chart's paper: primary lettering, cartouche ground */
  --chart-ink: #3d2f1f;        /* the chart's lettering ink: every site shadow */
}
/* The shell dresses once (#263), part A: the rules every page shell shares; per-page
   values stay in the page files. Since #268 the header is the Running Head, identical on
   every page (home's grander footer is pinned in public/index.css, whose link renders
   before this inline style and so sits above it in the cascade). */
:root { color-scheme: light; }
body {
  margin: 0;
  background: var(--parchment); color: var(--ink-dark);
  /* The daylight wash (Alex's call at the #289 review): lit from above, dimming at the
     foot, sized to the whole DOCUMENT. Alpha washes over --parchment, deliberately not
     palette tokens (shell-css.test.ts, the daylight-wash test). */
  background-image:
    radial-gradient(ellipse at 20% 10%, rgb(255 250 235 / 0.5), transparent 60%),
    radial-gradient(ellipse at 85% 90%, rgb(120 95 50 / 0.18), transparent 55%);
  font-family: var(--font-body, 'Iowan Old Style', 'Palatino', Georgia, serif);
}
main { margin-inline: auto; }
header { text-align: center; }
/* Punchcutter's Case (#228) roles on the shell members: display for wordmark, room name, nav band, footer; flourish for the tagline. */
.wordmark, .room-name, .topnav, footer {
  font-family: var(--font-display, 'Iowan Old Style', 'Palatino', Georgia, serif);
}
/* The Running Head (#268): a folio page header. The wordmark is the one place tracking
   opens up (Fell falls apart tracked out at text sizes); the room name baseline-aligns
   so Fell's irregular x-height cannot float it; beneath both, the ledger's double rule. */
.running-head { display: flex; justify-content: space-between; align-items: baseline;
  gap: 0.5rem 2rem; text-align: left; }
/* Head members pin line-height 1.6 (here and on .topnav): page css sets body line-height
   per page, and the head must not inherit that variance or its geometry differs page to page. */
/* Both head members pin font-weight: #288 swapped which tag carries which text, and h1/p
   carry OPPOSITE UA weight defaults while the display face has no bold cut, so unpinned
   the room name arrives as very visible synthetic bold. Do not "simplify" these away. */
.wordmark { font-size: 1.75rem; letter-spacing: 0.3em; margin: 0; line-height: 1.6; font-weight: 700; }
.wordmark a { color: inherit; text-decoration: none; }
.room { text-align: right; }
.room-name { font-size: 1rem; letter-spacing: 0.07em; margin: 0; line-height: 1.6; font-weight: 400; }
.tagline {
  font-family: var(--font-flourish, 'Iowan Old Style', 'Palatino', Georgia, serif);
  font-style: italic; color: var(--ink-brown); margin: 0.15rem 0 0; line-height: 1.6;
}
.head-rule { height: 3px; border-top: 1px solid var(--ink-dark);
  border-bottom: 1px solid var(--ink-dark); margin: 0.7rem 0 0; }
@media (max-width: 480px) {
  /* Longer room names collide with the wordmark on a narrow sheet: stack the head
     centered; the negative margin recenters the wordmark over its trailing letter-space. */
  .running-head { flex-direction: column; align-items: center; gap: 0.2rem; text-align: center; }
  .wordmark { margin-right: -0.3em; }
  .room { text-align: center; }
}
.topnav { font-size: 0.82rem; letter-spacing: 0.12em; color: var(--ink-faded); margin: 0.9rem 0 0; line-height: 1.6; }
/* motion.css makes nav LINKS inline-block so a multi-word label never wraps mid-label;
   the current page renders as a span, so it takes the same rule here. Ink-dark +
   manicule + underline: the you-are-here marker never relies on color alone (#268). */
.topnav [aria-current="page"] { display: inline-block; color: var(--ink-dark);
  text-decoration: underline; text-underline-offset: 0.45em; text-decoration-thickness: 1px; }
.topnav a { color: inherit; }
/* The manicule's glyph coverage is inconsistent across the Fell fallback stack: pin the plain serif stack and let the system substitute, never the display role. */
.manicule { font-family: 'Iowan Old Style', 'Palatino', Georgia, serif; }
footer { text-align: center; font-size: 0.72rem; letter-spacing: 0.22em; color: var(--ink-faded); }
footer a { color: inherit; }
</style>
</head>
<body>
<main>
<header>
  <div class="running-head">
    {/* #288: the room is the page's h1, so the heading outline a screen reader walks
        names the room rather than repeating VELLUM; home is roomless, so the wordmark
        stays its h1. Exactly one h1 either way, and the masthead still links home. */}
    {room
      ? <p class="wordmark"><a href="/">VELLUM</a></p>
      : <h1 class="wordmark"><a href="/">VELLUM</a></h1>}
    <div class="room">
      {room && <h1 class="room-name">{room}</h1>}
      <p class="tagline">{tagline}</p>
    </div>
  </div>
  <div class="head-rule"></div>
  <nav class="topnav">
    {NAV_ITEMS.map((item, i) => (
      <Fragment>{i > 0 ? " · " : ""}{item.href === path ? (
        <span aria-current="page"><span class="manicule" aria-hidden="true">☞&nbsp;</span>{item.label}</span>
      ) : (
        <a href={item.href}>{item.label}</a>
      )}</Fragment>
    ))}
  </nav>
  <slot name="header-extra" />
</header>

<slot />

<footer>
  VELLUM · AN ATELIER OF IMAGINARY CARTOGRAPHY
</footer>
</main>
</body>
</html>
