---
import { NAV_ITEMS } from "./nav.ts";

// The one shared shell (#203, ratified in the Sub 1 decision doc comment on #202): head
// meta with the prop fan-out, the canonical nav, the constant footer. The Running Head
// (#268) computes <title> from `room`, so title drift across pages is structurally impossible.
// Sub 6 (#461, rulings 2026-08-25): the shell wears the atelier-map idiom: the walnut
// deep as the sitewide ground, the fixed head cluster (wordmark, flourish tagline,
// dot-separated rooms nav) upper left over a reserved band, the room's h1 standing in the
// page (RoomHead.astro), and a landing ceremony for the rooms.
interface Props {
  /** Names the room for the computed <title> ("The Print Room · Vellum"); absent on home ALONE, whose title stays the atelier's own line. The page renders the matching <RoomHead>. */
  room?: string;
  /** The og twins' punctuation-normalized room, only when it differs from `room`: og:title AND twitter:title take `${ogRoom} · Vellum`. */
  ogRoom?: string;
  /** The name=description search snippet; also the og twins' default. */
  description: string;
  /** Fans out to og:description AND twitter:description, for a page whose card copy is shorter than its snippet; defaults to description. */
  ogDescription?: string;
  /** Root-absolute trailing-slash route ("/", "/faq/"): og:url + aria-current. */
  path: string;
  /** Sub 6 interim (#461): a room's <main> wears the desk panel until its own conversion sub (7-9) dresses the page for the deep; a page whose markup carries the full-bleed survey sheet passes "open" to stand bare on the deep. */
  desk?: "open";
  /** Extra root-absolute hrefs for SHARED sheets a page opts into; linked after the global sheets and before the page's own relative index.css, so page rules keep the last word. */
  extraCss?: readonly string[];
}

const { room, ogRoom, description, ogDescription, path, desk, extraCss = [] } = Astro.props;

for (const href of extraCss) {
  if (!href.startsWith("/")) {
    throw new Error(`BaseLayout extraCss hrefs must be root-absolute ("/living-chart.css"), got "${href}"`);
  }
}

if (!/^\/([a-z0-9-]+\/)*$/.test(path)) {
  throw new Error(`BaseLayout path must be root-absolute directory form ("/faq/"), got "${path}"`);
}
const isHome = path === "/";
if (isHome === (room !== undefined)) {
  throw new Error(
    isHome
      ? 'home is the atelier, not a room: pass no room for path "/"'
      : `every room page must name its room (got none for "${path}")`,
  );
}
if (desk !== undefined && room === undefined) {
  throw new Error('desk="open" is a room-page choice; home has no desk panel to open');
}

const HOME_TITLE = "Vellum · an atelier of imaginary cartography";
const SITE_TAGLINE = "an atelier of imaginary cartography";
const title = room ? `${room} · Vellum` : HOME_TITLE;
const ogTitle = ogRoom ? `${ogRoom} · Vellum` : title;
const ogUrl = new URL(path, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const ogImageAlt = "A Vellum antique chart beside the Vellum wordmark.";
const cardDescription = ogDescription ?? description;
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Vellum">
<meta property="og:url" content={ogUrl}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={cardDescription}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={cardDescription}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogImageAlt}>
<link rel="stylesheet" href="/fonts.css">
<link rel="stylesheet" href="/motion.css">
<link rel="stylesheet" href="/house.css">
{extraCss.map((href) => <link rel="stylesheet" href={href} />)}
<link rel="stylesheet" href="index.css">
{/* #329: prefetch the sibling shells so a first click commits instantly even while this
    page's plates are still streaming; derived from NAV_ITEMS plus home so the list can
    never rot; self is skipped. */}
{["/", ...NAV_ITEMS.map((item) => item.href)]
  .filter((href) => href !== Astro.url.pathname)
  .map((href) => <link rel="prefetch" href={href} />)}
<style is:global>
/* The shell dresses once (#263), part B: the recurring parchment/ink palette, consumed
   as var() by the page css files (guarded by test/site/shell-css.test.ts). The charts'
   own label ink stays the renderer's (byte-identity domain), deliberately not this hex. */
:root {
  --ink-dark: #4a3826;         /* dark walnut ink: borders, buttons, prose, emphasis */
  --ink-brown: #6b5a40;        /* flourish brown: taglines, captions, asides */
  --ink-faded: #857257;        /* faded ink: nav, footer, small labels */
  --line-tan: #b9a77f;         /* pale tan hairline: rules and frame borders */
  --parchment: #efe6cf;        /* the sheet ground (the body ground until Sub 6 sank it) */
  --parchment-panel: #f4ecd8;  /* raised panels, cards, and pinned slips */
  --parchment-bright: #fff7e4; /* the lit cream: hovers and the reveal */
  --parchment-deep: #e6d9b8;   /* the pressed tan: code chips */
  --line-faint: #cdbd97;       /* the softer hairline, a shade lighter than --line-tan */
  /* #367: the ONE depth a chart rests at, everywhere (was seven longhand 0.2 copies; the
     armed Explorer's doubled shadow measured 0.385 and 0.4 was ratified as the house
     depth). Anything laid OVER a chart inside the mount opts out: see public/living-chart.css. */
  --sheet-shadow: 0 12px 34px rgb(from var(--chart-ink) r g b / 0.4);
  /* The Specimen Book (#324, ratified 2026-07-30); the roster mirrors src/atlas/palette.ts exactly (the shell-css deepEqual). */
  --ink-annals: #3f3122;       /* the chronicler's iron-gall (journal entries, #312) */
  --ink-surveyor: #7a5f38;     /* the surveyor's walnut italic (journal prologue, #312) */
  --ink-surveyor-faded: #99855f; /* the surveyor's unbolded gutter days (#312) */
  --control-cream: #f8f1e0;    /* the control idiom's cream fill */
  --ink-press: #5d4831;        /* the dark primary pressed (hover) */
  --control-gold: #f0e3bd;     /* the featured action-link's parchment gold (#133/#199) */
  --control-gold-lit: #f7edcd; /* the gold, lit on hover */
  --ink-tale: #54452f;         /* the tale/note ink: place-card tales, atlas notes */
  --iron-red: #7a1f12;         /* the site's ink red (hunt star, statuses); was motion.css's */
  /* The --chart-* quotations borrow render/style.ts values (house-style.test.ts pins each
     to the constant it quotes). --chart-ink is the retired lettering ink's ONE sanctioned
     site-side home (shell-css pins this declaration); shadows consume it via rgb(from ...). */
  --chart-paper: #f2e8cf;      /* the antique chart's paper: primary lettering, cartouche ground */
  --chart-ink: #3d2f1f;        /* the chart's lettering ink: every site shadow */
  /* Sub 6 (#461 ruling 2): the walnut deep, the atelier-map mockup's own body ground and
     the daylight wash's dark successor. The lighter walnut center is the SAME token-derived
     mix Act I ratified for the stage (design/atelier-map's #55402a; nothing invented, no
     new token, so the paper-light atlas download stays untouched). Declared once; the body
     ground and the running band consume it so their paint can never drift apart. */
  --the-deep:
    radial-gradient(120% 90% at 50% 30%, rgb(from var(--ink-dark) r g b / 0) 40%, rgb(from var(--chart-ink) r g b / 0.55) 100%),
    radial-gradient(80% 70% at 30% 20%, color-mix(in srgb, var(--ink-dark) 90%, var(--parchment) 10%) 0%, var(--ink-dark) 55%, var(--chart-ink) 100%);
  /* #461 ruling 5: the reserved walnut band the head cluster stands on; the sheet scrolls
     beneath the band, never beneath bare lettering. */
  --band-h: 7.6rem;
  --chrome-x: 1.6rem; --chrome-y: 1.4rem;
}
/* The shell dresses once (#263), part A: the rules every page shell shares; per-page
   values stay in the page files (the layout's inline style renders AFTER the page css
   link, so an equal-specificity page rule silently loses, so page deviations need higher
   specificity). A palette inversion, not a dark mode (#454): form controls stay light. */
:root { color-scheme: light; }
body {
  margin: 0;
  background: var(--chart-ink); color: var(--ink-dark);
  font-family: var(--font-body, 'Iowan Old Style', 'Palatino', Georgia, serif);
}
/* The deep paints on a fixed full-viewport layer, not background-attachment (iOS treats
   fixed attachment as scroll); the band clips the IDENTICAL layer, so the two can never
   misalign by construction. */
body::before {
  content: ""; position: fixed; inset: 0; z-index: -1;
  background: var(--the-deep);
  background-color: var(--chart-ink);
}
main { margin-inline: auto; }
/* Punchcutter's Case (#228) roles on the shell members: display for wordmark, room name, rooms nav, footer; flourish for the taglines. */
.wordmark, .room-name, .rooms, footer {
  font-family: var(--font-display, 'Iowan Old Style', 'Palatino', Georgia, serif);
}
/* The head cluster (#461 ruling 1, re-ratifying #268: one masthead, one nav): fixed upper
   left, directly on the deep. It pins its own leading (second addendum on #461): page css
   sets body line-height for READING and the cluster must not inherit that inflation. */
header.chrome {
  position: fixed; left: var(--chrome-x); top: var(--chrome-y); z-index: 10;
  line-height: normal; text-align: left;
  pointer-events: none;
}
header.chrome a, header.chrome .rooms-reveal { pointer-events: auto; }
/* Both weight pins survive #288's tag swap: the wordmark is h1 on home and p on rooms,
   whose UA weights differ while the display face has no bold cut; unpinned, home's
   wordmark arrives as synthetic bold. The cluster sets 400 (the mockup's own weight). */
.wordmark { font-size: 2.1rem; letter-spacing: 0.12em; line-height: 1.15; font-weight: 400; margin: 0; }
.wordmark a { color: var(--parchment-bright); text-decoration: none; }
.tagline {
  font-family: var(--font-flourish, 'Iowan Old Style', 'Palatino', Georgia, serif);
  font-style: italic; font-size: 0.92rem; color: var(--parchment); margin: 0;
}
.rooms { font-size: 0.72rem; letter-spacing: 0.14em; color: var(--ink-faded); margin: 0.55rem 0 0; }
.rooms .sep { margin: 0 0.35em; opacity: 0.7; }
.rooms a { color: var(--parchment); text-decoration: none; }
.rooms a:hover, .rooms a:focus-visible { color: var(--parchment-bright); }
header.chrome a:focus-visible, footer a:focus-visible { outline-color: var(--parchment-bright); }
.rooms [aria-current="page"] { display: inline-block; vertical-align: top; color: var(--parchment-bright);
  text-decoration: underline; text-underline-offset: 0.45em; text-decoration-thickness: 1px; }
.band { position: fixed; inset: 0; z-index: 9; pointer-events: none; }
.band::before {
  content: ""; position: absolute; inset: 0;
  background: var(--the-deep);
  background-color: var(--chart-ink);
  clip-path: inset(0 0 calc(100% - var(--band-h)) 0);
}
.band::after {
  content: ""; position: absolute; left: 0; right: 0; top: var(--band-h); height: 14px;
  background: linear-gradient(rgb(from var(--chart-ink) r g b / 0.45), transparent);
}
.room-head { text-align: center; margin: 0 0 1.4rem; line-height: 1.6; }
.room-name { font-size: 1.65rem; font-weight: 400; letter-spacing: 0.14em; margin: 0; }
.room-tagline {
  font-family: var(--font-flourish, 'Iowan Old Style', 'Palatino', Georgia, serif);
  font-style: italic; color: var(--ink-brown); margin: 0;
}
/* The rooms stand clear of the band; the survey pages' 2.2rem margins are ruling 3's. */
body.room { padding: 8.4rem 2.2rem 1.6rem; }
/* Sub 6 interim: until a room's own conversion sub (7-9) dresses its page for the deep,
   its <main> wears a plain desk panel so nothing ships ink-on-walnut unreadable. A page
   passes desk="open" once its markup carries the full-bleed sheet; the class then simply
   stops being rendered, so this rule retires itself room by room. */
main.desk-panel {
  background: var(--parchment);
  border: 1px solid var(--line-tan);
  box-shadow: var(--sheet-shadow);
  padding: 1.8rem clamp(1.25rem, 3vw, 2.75rem) 2.75rem;
}
/* The landing ceremony (#461 ruling 6): the sheet settles onto the desk and the chrome
   inks in just after. Plays every arrival (build-time call recorded on #461: it is one
   0.55s CSS settle, and gating would cost the rooms a third sitewide script; #465's
   post-use review re-rules if it grates). motion.css's reduced-motion blanket collapses
   both to an instant swap. Home keeps its own ceremony (#457). */
@keyframes sheet-land {
  from { opacity: 0; transform: translateY(10px) scale(1.004); }
}
@keyframes ink-in { from { opacity: 0; } }
body.room main { animation: sheet-land 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) both; }
body.room header.chrome, body.room footer { animation: ink-in 0.5s 0.18s ease-out both; }
footer {
  text-align: center; font-size: 0.72rem; letter-spacing: 0.22em; color: var(--line-tan);
  padding: 1.4rem 0 1.8rem; margin: 0; line-height: normal;
}
footer a { color: inherit; }
@media (max-width: 720px) {
  :root { --band-h: 6.4rem; --chrome-x: 1rem; --chrome-y: 0.9rem; }
  .wordmark { font-size: 1.5rem; }
  .tagline { font-size: 0.78rem; }
  /* The nav stays on room pages at narrow (a room page has no other door); home alone
     folds its rooms into the drawer under 900px (public/index.css). */
  .rooms { max-width: calc(100vw - 2rem); }
  body.room { padding: 7rem 1rem 1.2rem; }
}
/* Print is paper (#454 open decision 4, executed for the page chrome here, the artifacts
   at Sub 9): the fixed dark chrome must not stamp itself onto every printed page. */
@media print {
  .band, header.chrome { display: none; }
  body { background: none; }
  body::before { display: none; }
  body.room { padding: 0; }
  main.desk-panel { background: none; border: none; box-shadow: none; }
}
</style>
</head>
<body class={room ? "room" : undefined}>
{room && <div class="band" aria-hidden="true"></div>}
<header class="chrome">
  {/* #288: the room's h1 stands in the page (RoomHead.astro), so home alone keeps the
      wordmark as its h1 (roomless, there is nothing else its h1 could be). Exactly one
      h1 either way, and the masthead still links home. Fell SC sets the small caps, so
      the wordmark stays a mixed-case string. */}
  {room
    ? <p class="wordmark"><a href="/">Vellum</a></p>
    : <h1 class="wordmark"><a href="/">Vellum</a></h1>}
  <p class="tagline">{SITE_TAGLINE}</p>
  {/* The phone reveal (#461, 2026-08-26 call): under 900px home stands the nav down and this native checkbox burger reveals it, no bundle required; a room page's nav never stands down, so no reveal. Styled and shown by public/index.css alone. */}
  {!room && <input type="checkbox" class="rooms-reveal" aria-label="Reveal the rooms nav" />}
  <nav class="rooms" aria-label="The rooms">
    {NAV_ITEMS.map((item, i) => (
      <Fragment>{i > 0 ? <span class="sep" aria-hidden="true">·</span> : ""}{item.href === path ? (
        <span aria-current="page">{item.label}</span>
      ) : (
        <a href={item.href}>{item.label}</a>
      )}</Fragment>
    ))}
  </nav>
  <slot name="header-extra" />
</header>
<main class:list={[room && desk !== "open" && "desk-panel"]}>

<slot />

</main>
<footer>
  Vellum · an atelier of imaginary cartography
</footer>
</body>
</html>
