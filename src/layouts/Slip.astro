---
// Sub 7 (#462, chart-room ruling 3 and document-room ruling 1; the Atelier Kit, #487): the room's working panel, the mockup's station card grown into a desk. Verb / title / where head, a scrolling body, an optional foot; it folds to a bookmark tab on the right edge, and on a phone it is the bottom sheet collapsed to its title. The behaviour is src/site/shared/slip.ts, bound by whichever script the page runs.
interface Props {
  /** The panel's id; its title takes `${id}-title` for aria-labelledby. */
  id: string;
  verb: string;
  title: string;
  where: string;
  /** The fold button's accessible name ("Fold the hunt away"). */
  fold: string;
}
const { id, verb, title, where, fold } = Astro.props;
const titleId = `${id}-title`;
---
<aside class="slip" id={id} aria-labelledby={titleId}>
  <div class="slip-head">
    <button class="slip-fold" type="button" aria-label={fold}>&times;</button>
    <p class="card-verb">{verb}</p>
    <h2 class="card-title" id={titleId}>{title}</h2>
    <p class="card-where">{where}</p>
  </div>
  <div class="slip-body"><slot /></div>
  {Astro.slots.has("foot") && <div class="slip-foot"><slot name="foot" /></div>}
</aside>
<button class="slip-tab" type="button" aria-controls={id}>{title}</button>
