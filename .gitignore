# No trailing slash, deliberately. `node_modules/` matches only a DIRECTORY, and the
# sandbox recipe in scripts/agent-sandbox.ts creates node_modules
# as a SYMLINK to the parent checkout's. Git sees a symlink as a file, so the slashed form
# let it straight through, and a `git add -A` from such a worktree committed a link whose
# contents are an absolute path on one machine. Caught on PR #369, 2026-08-12.
node_modules
out/
*.log
.DS_Store

# Built deploy artifact (assembled by `npm run build`, published by deploy.yml).
dist/

# Astro's generated types/cache dir (#203).
.astro/

# The build-output folder (Issue #768): what `npm run astro:generate` writes, rebuilt whole before every dev and build.
/generated/

.claude/settings.local.json
# Transient review worktrees spawned by Claude Code workflows.
.claude/worktrees/
SESSION-NOTES.md
SESSION-NOTES-ARCHIVE-*.md
RESUME-HERE.md
# CLAUDE.md was local-only until 2026-08-08 and is now TRACKED (it is project
# instructions, not personal notes). RESUME-HERE and the session notes stay
# ignored: they are per-session state, not instructions.

# Local planning docs, no longer tracked. Backlog lives in GitHub issues.
roadmap/
